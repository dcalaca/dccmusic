  "faqPage": {
    "sections": [
      {
        "category": "DCC Music",
        "questions": [
          {
            "question": "What is DCC Music?",
            "answer": "DCC Music is a platform where you can listen to songs and watch videos, discover songwriters, and create music with artificial intelligence. Signed-in songwriters also have access to AI Studio, Song Chords, and promotion tools."
          },
          {
            "question": "Do I need to pay to use the website?",
            "answer": "No. Listening to songs and watching videos is free and does not require an account. To comment, rate content, or create with AI Studio, use a songwriter account."
          },
          {
            "question": "Can I listen to songs and watch videos on my phone?",
            "answer": "Yes. The website works on phones, tablets, and computers. For the best experience, use an up-to-date browser such as Chrome, Edge, Safari, or Firefox."
          }
        ]
      },
      {
        "category": "Songwriter Area",
        "questions": [
          {
            "question": "How do I sign up as a songwriter?",
            "answer": "Open the songwriter sign-up page, enter your information, and create your account. You can then manage songs, videos, AI Studio projects, credits, and your account statement."
          },
          {
            "question": "What can I do in the songwriter area?",
            "answer": "You can create songs with AI Studio, generate song chords, publish songs and videos, manage projects, buy credits, comment, rate content, and use the features included in your plan."
          },
          {
            "question": "I forgot my password. What should I do?",
            "answer": "On the songwriter login page, select the password recovery option and follow the instructions. Contact support if you still cannot access your account."
          },
          {
            "question": "Where can I see my credit balance and statement?",
            "answer": "After signing in, select your name at the top of the website and open Account & Statement. It shows your balance, transactions, and usage history."
          }
        ]
      },
      {
        "category": "AI Studio",
        "questions": [
          {
            "question": "What is AI Studio?",
            "answer": "AI Studio is the DCC Music tool for creating songs with artificial intelligence. Enter a title, style, mood, and idea, and the platform helps create lyrics, arrangement, audio, and cover art."
          },
          {
            "question": "Can AI create the lyrics too?",
            "answer": "Yes. You can generate lyrics from scratch, improve existing lyrics, or complete an idea you have already started."
          },
          {
            "question": "Can I upload a finished song to improve it?",
            "answer": "Yes. Use Improve Song to upload an audio reference and create a new production."
          },
          {
            "question": "Can I record my voice directly on the website?",
            "answer": "Yes. You can record in your browser, sing a short section or idea, review the transcription, and use the recording as a reference."
          },
          {
            "question": "Can I use my own cloned voices?",
            "answer": "Yes. When available for your account, you can add and verify voices for use in AI Studio creations."
          },
          {
            "question": "What is the maximum song length?",
            "answer": "AI Studio is designed to create songs up to 4 minutes and 30 seconds long. This helps prevent excessively long or repetitive audio."
          },
          {
            "question": "Can I choose between the two generated versions?",
            "answer": "Yes. When a project has multiple versions, you can listen to each one and choose the version you want to use or turn into song chords."
          }
        ]
      },
      {
        "category": "Song Chords",
        "questions": [
          {
            "question": "What are Song Chords on DCC Music?",
            "answer": "This service organizes the lyrics and chords of your AI Studio song into a clean chord sheet that is ready to play or print."
          },
          {
            "question": "How much does it cost to generate song chords?",
            "answer": "A successful generation costs 10 DCC credits."
          },
          {
            "question": "What do I receive?",
            "answer": "You receive a PDF chord sheet and can also view the lyrics and chords on screen, including the key and BPM when available."
          },
          {
            "question": "Can I use a song created in AI Studio?",
            "answer": "Yes. Select the version you want on the Song Chords page. The platform may automatically select a version when you arrive from a recent project."
          },
          {
            "question": "Can I upload my own audio?",
            "answer": "During this initial phase, Song Chords is available for songs created in AI Studio."
          },
          {
            "question": "Where are my chord sheets saved?",
            "answer": "Completed chord sheets remain saved in your account so you can download them again."
          },
          {
            "question": "Will I pay again if I generate the same song?",
            "answer": "No. If the chord sheet was completed before, the saved result is reused without deducting credits again."
          }
        ]
      },
      {
        "category": "Credits and Payments",
        "questions": [
          {
            "question": "How do AI Studio credits work?",
            "answer": "Each AI Studio song uses credits. A new Song Chords generation uses 10 credits. Credits may come from your plan, one-time purchases, or current promotions."
          },
          {
            "question": "Can I buy credits without a monthly plan?",
            "answer": "Yes. You can buy song credits to create songs and chord sheets without relying on a monthly plan. Larger purchases may have a lower per-song price."
          },
          {
            "question": "Where can I see what used my credits?",
            "answer": "Open Account & Statement from the menu under your name. It lists AI Studio creations, chord sheets, credit purchases, and other transactions."
          },
          {
            "question": "Are purchased credits added immediately?",
            "answer": "Credits are normally added automatically after payment confirmation. If your payment was approved but the credits are missing, contact support with your account email."
          }
        ]
      },
      {
        "category": "Projects, Songs, and Support",
        "questions": [
          {
            "question": "Where are my AI-created songs?",
            "answer": "Your songs are stored under My Projects in AI Studio. Each project may include lyrics, cover art, generated versions, and creation history."
          },
          {
            "question": "Can I share a song or video?",
            "answer": "Yes. Public song and video pages can be shared by link. You can also publish an AI Studio song on DCC Music and use its public link or embedded player."
          },
          {
            "question": "How do I find music by style?",
            "answer": "Use the filters on the public song and video pages to search by genre, songwriter, or content."
          },
          {
            "question": "How do I request help with a specific project?",
            "answer": "Open the project in AI Studio, copy its project code, and include that code when contacting support."
          },
          {
            "question": "How do I report a website problem?",
            "answer": "Email suporte@dccmusic.online. If possible, include your account email, project code, and a short description of what happened."
          }
        ]
      }
    ],
